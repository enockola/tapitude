<dialog id="<%= id %>">
  <p><%= message %></p>
  
  <form method="dialog" class="button_panel">
    <button value="cancel">Cancel</button>
    <button value="confirm" class="danger">
      <%= confirmText || 'Confirm' %>
    </button>
  </form>
</dialog>

<script>
  const dialog = document.getElementById("<%= id %>");
  const confirmBtn = document.querySelector("#<%= id %> button[value='confirm']");
  
  // This variable is passed from the server or defined in the EJS scope
  const actionUrl = "<%= actionUrl %>";

  confirmBtn.addEventListener("click", () => {
    // Dynamic logic based on the parameter
    console.log("Action URL: ", actionUrl);
    window.location.href = actionUrl;
  });
</script>