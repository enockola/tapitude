<header class="topbar">
  <a class="brand" href="/"><img src="/assets/tapitude-logo.png" alt="Tapitude"></a>

  <button class="topbar__toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="topbar__menu" id="site-navigation" data-menu>
    <nav class="topbar__nav" aria-label="Main navigation">
      <% if (currentUser) { %>
      <% if (currentUser.role === "admin") { %>
      <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/admin/creators" class="<%= currentPath === '/admin/creators' ? 'is-active' : '' %>">Creators</a>
      <a href="/admin/settings" class="<%= currentPath === '/admin/settings' ? 'is-active' : '' %>">Settings</a>
      <% } else { %>
      <a href="/creator/dashboard" class="<%= currentPath === '/creator/dashboard' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/creator/content" class="<%= currentPath === '/creator/content' ? 'is-active' : '' %>">Content</a>
       <a href="/creator/profile" class="<%= currentPath === '/creator/profile' ? 'is-active' : '' %>">Profile</a>
      <% } %>
      <% } else { %>
      <a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">About</a>
      <a href="/auth/login" class="<%= currentPath === '/auth/login' ? 'is-active' : '' %>"><i class="ph ph-user"></i> Log in</a>
      <% } %>
      <% if (currentUser) { %>
        <form action="/auth/logout" method="POST" style="display: inline;cursor: pointer;">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button type="submit" ><i class="ph ph-user"></i> Log out</button>
        </form>
      <% } %>
    </nav>
  </div>
</header>