<header class="topbar">
  <a class="brand" href="/">Tapitude</a>

  <button
    class="topbar__toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="site-navigation"
    data-menu-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="topbar__menu" id="site-navigation" data-menu>
    <nav class="topbar__nav" aria-label="Main navigation">
      <% if (currentUser) { %>
        <% if (currentUser.role === "admin") { %>
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/creators">Creators</a>
        <% } else { %>
          <a href="/creator/dashboard">Dashboard</a>
          <a href="/creator/content">Content</a>
        <% } %>
      <% } else { %>
        <a href="/about">About</a>
        <a href="/auth/login">Log in</a>
      <% } %>
    </nav>

    <% if (currentUser) { %>
      <form action="/auth/logout" method="POST">
        <button class="button button--ghost" type="submit">Log out</button>
      </form>
    <% } %>
  </div>
</header>
