<% 
  // Set up safe default values if they aren't passed in
  const inputName = typeof name !== 'undefined' ? name : 'password';
  const inputId = typeof id !== 'undefined' ? id : 'password_' + Math.random().toString(36).substr(2, 9);
  const inputPlaceholder = typeof placeholder !== 'undefined' ? placeholder : 'Enter password';
  const inputRequired = typeof required !== 'undefined' && required ? 'required' : '';
  const inputClass = typeof className !== 'undefined' ? className : 'form-control';
%>

<div class="password-field-wrapper">
  <input
   type="password"
   name="<%= inputName %>"
   id="<%= inputId %>"
   placeholder="<%= inputPlaceholder %>"
   class="<%= inputClass %>" <%= inputRequired %> 
   autocomplete="<%= typeof autocomplete !== 'undefined' ? autocomplete : 'user-password' %>"
   <% if (typeof dontMinLength === 'undefined') { %>
   minlength="8"
   <% } %>
  >
  <button type="button" class="password-toggle-trigger" data-target="<%= inputId %>">
    <i class="ph ph-eye"></i>
  </button>
</div>

<style>
  .password-field-wrapper i {
    font-size: 1.5em;
  }

  .password-field-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .password-field-wrapper input {
    width: 100%;
    padding-right: 60px !important;
    /* Prevent text running into the button */
  }

  .password-toggle-trigger {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: #6c757d;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    user-select: none;
    padding: 4px 8px;
    transition: color 0.15s ease-in-out;
  }

  .password-toggle-trigger:hover {
    color: #212529;
  }
</style>
<script>
  (function() {
    if (window.passwordToggleInitialized) return;

    document.addEventListener('click', function(e) {
      // Find the button, even if they clicked the <i> icon inside it
      const button = e.target.closest('.password-toggle-trigger');

      if (button) {
        const targetId = button.getAttribute('data-target');
        const input = document.getElementById(targetId);

        if (input) {
          const isPassword = input.type === 'password';
          input.type = isPassword ? 'text' : 'password';

          // Correctly update the icon HTML
          button.innerHTML = isPassword ?
            '<i class="ph ph-eye-slash"></i>' :
            '<i class="ph ph-eye"></i>';
        }
      }
    });

    window.passwordToggleInitialized = true;
  })();
</script>