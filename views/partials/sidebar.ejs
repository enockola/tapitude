<aside class="sidebar">
  <div class="sidebar__title">
    <strong>CreatorHub</strong>
    <span>Manage your digital presence</span>
  </div>

  <nav class="sidebar__nav" aria-label="Dashboard navigation">
    <% if (currentUser && currentUser.role === "admin") { %>
    <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'is-active' : '' %>">Dashboard</a>
    <a href="/admin/creators" class="<%= currentPath === '/admin/creators' ? 'is-active' : '' %>">Creators</a>
    <a href="/admin/settings" class="<%= currentPath === '/admin/settings' ? 'is-active' : '' %>">Settings</a>
    <% } else { %>
    <a href="/creator/dashboard" class="<%= currentPath === '/creator/dashboard' ? 'is-active' : '' %>">Dashboard</a>
    <a href="/creator/content" class="<%= currentPath === '/creator/content' ? 'is-active' : '' %>">Content</a>
    <a href="/creator/profile" class="<%= currentPath === '/creator/profile' ? 'is-active' : '' %>">Settings</a>
    <% } %>
  </nav>

  <% if (currentUser) { %>
  <% if (currentUser && currentUser.role === "admin") { %>
  <%- include("../admin/create-button") %>
  <% }else{ %>
  <%- include("../creator/partial-create-button") %>
  <% }} %>
</aside>