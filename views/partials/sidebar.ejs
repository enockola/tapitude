<aside class="sidebar">
  <div class="sidebar__title">
    <strong>CreatorHub</strong>
    <span>Manage your digital presence</span>
  </div>

  <nav class="sidebar__nav" aria-label="Dashboard navigation">
    <% if (currentUser && currentUser.role === "admin") { %>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/creators">Creators</a>
      <a href="/admin/creators/new">New Creator</a>
    <% } else { %>
      <a href="/creator/dashboard">Dashboard</a>
      <a href="/creator/content">My Content</a>
      <a href="/creator/profile">Settings</a>
    <% } %>
  </nav>

  <% if (currentUser && currentUser.role !== "admin") { %>
    <a class="button button--full sidebar__cta" href="/content-pages/new">+ New Post</a>
  <% } %>
</aside>
