<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">CreatorHub</p>
    <h1>Your Performance</h1>
    <p>Quick overview of your content pages.</p>
  </div>
  <%- include("./partial-create-button") %>
</section>

<section class="stats-grid">

  <article class="stat-card">
    <span>Total Likes</span>
    <strong><%= stats.totalLikes %></strong>
  </article>

  <article class="stat-card">
    <span>Total Views</span>
    <strong><%= stats.totalViews %></strong>
  </article>
</section>

<%
  const publishedContent = contentPages.filter((page) => page.publishDate < new Date());
  const scheduledContent = contentPages.filter((page) => page.publishDate > new Date());
  function makePageDescription(page) {
  let pageTitle = ""; 
  if (page.body) {
    pageTitle =
      "\""+(page.body.length > 50
        ? page.body.slice(0, 50) + "..."
        : page.body)+"\"";
  } 
  if(page.fileKey) {
    pageTitle += " (1 attachment)";
  }
  return pageTitle;
}
%>

<section class="dashboard-grid">


  <article class="card">
    <div class="card-header">
      <h2>Scheduled Content (<%= scheduledContent.length %>)</h2>
      <a href="/creator/content">View all</a>
    </div>

    <% if (scheduledContent.length === 0) { %>
    <p>No scheduled content.</p>
    <% } else { %>
    <div class="mini-list">
      <% scheduledContent.forEach((page) => { %>
      <div class="mini-list__item">
        <div class="content-summary"><%= makePageDescription(page) %>
        <label class="badge"> Scheduled: <%= page.publishDate ? formatEtDateTime(page.publishDate) : "No date" %> </label></div>
        

        <div class="row-actions">
          <a class="button button--small button--secondary" href="/creator/pages/<%= page._id %>/editor">
            <i class="ph-fill ph-pencil-simple-line" style="margin-right: 5px;"></i> <span>Edit</span>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </article>

  <article class="card">
    <div class="card-header">
      <h2>Published Content (<%= publishedContent.length %>)</h2>
      <a href="/creator/content">View all</a>
    </div>

    <% if (publishedContent.length === 0) { %>
    <p>No published content yet.</p>
    <% } else { %>
    <div class="mini-list">
      <% publishedContent.forEach((page) => { %>
      <div class="mini-list__item">
        <div class="content-summary"><%= makePageDescription(page) %>
           <label class="badge">Published: <%= page.publishDate ? formatEtDateTime(page.publishDate) : "No date" %></label></div>
     

        <div class="row-actions">
          <a class="button button--small button--secondary" href="/creator/pages/<%= page._id %>/editor">
            <i class="ph-fill ph-pencil-simple-line" style="margin-right: 5px;"></i> <span>Edit</span>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </article>
</section>

<%- include("../partials/dashboard-shell-end") %>