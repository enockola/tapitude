<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">CreatorHub</p>
    <h1>Your Performance</h1>
    <p>Quick overview of your content pages.</p>
  </div>
  <%- include("./create-button") %>
</section>

<section class="stats-grid">
  <article class="stat-card">
    <span>Total Pages</span>
    <strong><%= stats.totalPages %></strong>
  </article>

  <article class="stat-card">
    <span>Published</span>
    <strong><%= stats.publishedPages %></strong>
  </article>

  <article class="stat-card">
    <span>Scheduled</span>
    <strong><%= stats.scheduledPages %></strong>
  </article>
</section>

<%
  const publishedContent = contentPages.filter((page) => page.status === "published");
  const scheduledContent = contentPages.filter((page) => page.status === "scheduled");
%>

<section class="dashboard-grid">
  <article class="card">
    <div class="card-header">
      <h2>Published Content</h2>
      <a href="/creator/content">View all</a>
    </div>

    <% if (publishedContent.length === 0) { %>
      <p>No published content yet.</p>
    <% } else { %>
      <div class="mini-list">
        <% publishedContent.forEach((page) => { %>
          <div class="mini-list__item">
            <div class="content-summary">
              <a href="/content-pages/<%= page._id %>/edit">
                <strong><%= page.title %></strong>
              </a>

              <a class="public-link" href="/p/<%= page.slug %>" target="_blank">
                /p/<%= page.slug %>
              </a>
            </div>

            <div class="item-meta">
              <small class="badge">
                Published:
                <%= page.publishedAt ? formatEtDateTime(page.publishedAt) : "No date" %>
              </small>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </article>

  <article class="card">
    <div class="card-header">
      <h2>Scheduled Content</h2>
      <a href="/creator/content">View all</a>
    </div>

    <% if (scheduledContent.length === 0) { %>
      <p>No scheduled content yet.</p>
    <% } else { %>
      <div class="mini-list">
        <% scheduledContent.forEach((page) => { %>
          <div class="mini-list__item">
            <div class="content-summary">
              <a href="/content-pages/<%= page._id %>/edit">
                <strong><%= page.title %></strong>
              </a>

              <span class="muted-link">/p/<%= page.slug %></span>
            </div>

            <div class="item-meta">
              <small class="badge">

                Scheduled:

                <%= page.scheduledFor ? formatEtDateTime(page.scheduledFor) : "No date" %>

              </small>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>

<%- include("../partials/dashboard-shell-end") %>
