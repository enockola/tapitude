<%- include("../partials/dashboard-shell-start", { title }) %>
<script>
  const fileMetadata = <%- JSON.stringify(fileMetadata) %>;
  const isNewPage = <%- contentPage ? "false" : "true" %>;
</script>

<section class="content-header">
  <div>
    <p class="eyebrow">Content</p>
    <h1><%= contentPage ? "Edit Post" : "New Post" %></h1>
    <p>Create a simple public page for consumers to view from an NFC chip.</p>
  </div>
</section>

<section class="editor-layout">
  <article class="card">
    <% if (error) { %>
    <p class="form-error"><%= error %></p>
    <% } %>



    <!-- If content page exists, we are editing it, otherwise we are creating a new one -->
    <form action="/creator/pages/upload" method="POST" enctype="multipart/form-data" id="mediaForm">

      <!-- We include the page ID so that the server can identify which page to update. If this is a new page, the ID will be null -->
      <input type="hidden" name="postID" value="<%= contentPage ? contentPage._id : null %>">

      <div class="media-upload">
        <label class="media-dropzone" for="mediaUploadInput" id="mediaUploadDropzone">
          <span class="media-dropzone__icon">
            <% if (fileMetadata) { %>
            <i class="ph ph-file-image"></i>
            <% } else { %>
            <i class="ph ph-upload-simple"></i>
            <% } %>
          </span>
          <strong id="mediaUploadLabel">Your Media</strong>
          <small id="mediaUploadHint">Upload your content video and images</small>

          <span class="button button--secondary button--small">
            Browse Files
          </span>

          <input id="mediaUploadInput" type="file" name="media" accept="image/*,video/*">
        </label>

        <div class="progress-container" id="upload-progress-container" style="display: none;">
          <span class="progress-text" id="upload-progress-text">0% Uploaded</span>
          <div class="progress-fill" id="upload-progress-fill"></div>
        </div>
        <% if (contentPage?.mediaUrl) { %>
        <div class="current-media">
          <p class="eyebrow">Current Media</p>

          <% if (contentPage.mediaType?.startsWith("image")) { %>
          <img src="<%= contentPage.mediaUrl %>" alt="Uploaded media preview">
          <% } else if (contentPage.mediaType?.startsWith("video")) { %>
          <video controls src="<%= contentPage.mediaUrl %>"></video>
          <% } else { %>
          <a href="<%= contentPage.mediaUrl %>" target="_blank">View uploaded media</a>
          <% } %>
        </div>
        <% } %>
        <div>

        </div>
      </div>
      <div class="form-actions">
        <button class="button" type="button" id="uploadAttatchmentBtn"> <i class="ph ph-upload-simple"></i> Upload Media</button>
        <button class="button button--danger" type="button" id="deleteAttatchmentBtn"> <i class="ph ph-trash"></i> Delete Media</button>
      </div>
    </form>

    <div class="divider"></div>

    <form action="<%= contentPage ? `/creator/pages/${contentPage._id}/update` : '/creator/pages/create' %>" method="POST" class="form-stack" id="contentForm">
      <!-- We include the page ID so that the server can identify which page to update. If this is a new page, the ID will be null -->
      <input type="hidden" name="postID" value="<%= contentPage ? contentPage._id : null %>">

      <label>
        Description
        <textarea class="uploadInput" name="body" rows="8" placeholder="Tell your story..."><%= contentPage?.body || '' %></textarea>
      </label>


      <label>
        Publish Option
        <select name="status" id="publishOption">
          <% const currentStatus = contentPage?.status || "published"; %>
          <option value="published" <%= currentStatus === "published" ? "selected" : "" %>>Publish now</option>
          <option value="scheduled" <%= currentStatus === "scheduled" ? "selected" : "" %>>Schedule for later</option>
          <option value="draft" <%= currentStatus === "draft" ? "selected" : "" %>>Save as draft</option>
        </select>
      </label>

      <label id="scheduledForLabel">
        Schedule Time (<%= scheduleTimeZoneLabel %>)
        <input type="datetime-local" name="scheduledFor" id="scheduledFor" value="<%= toEtDateTimeInputValue(contentPage?.scheduledFor) %>">
        <small class="field-hint">
          NOTE: All scheduled posts use Eastern Time.
          <!--The server saves this as UTC.-->
        </small>
      </label>

      <div class="form-actions">
        <button class="button" type="submit" id="save-content-btn">Publish</button>

        <% if (contentPage) { %>
        <button class="button button--danger" type="button" id="delete-content-btn" onclick="deletePost()">
          <i class="ph ph-trash"></i> Delete
        </button>
        <% } %>
      </div>
    </form>

    <% if (contentPage) { %>
    <form id="delete-content-form" action="<%= `/creator/pages/${contentPage._id}/delete` %>" method="POST"></form>
    <% } %>
  </article>

  <aside class="card preview-card">
    <p class="eyebrow">Preview</p>
    <button class="button"> <i class="ph ph-eye"></i> Preview Page</button>
  </aside>
</section>

<script>
  const form = document.getElementById("contentForm");
  const mediaForm = document.getElementById("mediaForm");
  const deleteForm = document.getElementById("delete-content-form");

  const fileInput = document.getElementById("mediaUploadInput");
  const mediaDropzone = document.getElementById("mediaUploadDropzone");
  const mediaLabel = document.querySelector("#mediaUploadLabel");
  const mediaHint = document.querySelector("#mediaUploadHint");
  const mediaInput = document.querySelector("#mediaUploadInput");
  const saveContentBtn = document.querySelector("#save-content-btn");

  const uploadBtn = document.getElementById("uploadAttatchmentBtn");
  const deleteMediaBtn = document.getElementById("deleteAttatchmentBtn");

  const uploadProgressContainer = document.getElementById("upload-progress-container");
  const uploadProgressText = document.getElementById("upload-progress-text");
  const uploadProgressFill = document.getElementById("upload-progress-fill");

  deleteMediaBtn.addEventListener("click", () => {
    if (confirm("Are you sure you want to delete this media? This action cannot be undone!") === true) {
      mediaInput.value = "";
      uploadProgressContainer.style.display = "none";
      submitMediaForm();
      updateMediaLabel(null, null);
    }
  });

  function deletePost() {
    if (confirm("Are you sure you want to delete this post? This action cannot be undone!") === true) {
      deleteForm.submit();
    }
  }

  uploadBtn.addEventListener("click", () => {
    if (mediaInput.value) {
      submitMediaForm();
    } else {
      alert("Please select a file to upload");
    }
  });

  mediaForm.addEventListener("submit", async (e) => {
    e.preventDefault(); // stop normal page reload
    submitMediaForm();
  });

  // form.addEventListener("submit", async (e) => {
  //   e.preventDefault(); // stop normal page reload
  //   submitForm();
  // });

  function uploadProgress(percent, loaded, total) {

    if (percent === 100) {
      uploadProgressFill.style.width = "100%";
      // uploadProgressContainer.style.display = "none";
      uploadProgressText.textContent = "Upload successful";
      console.log("Upload successful");
    } else {
      uploadProgressContainer.style.display = "block";
      uploadProgressFill.style.width = `${percent}%`;
      uploadProgressText.textContent = `${percent.toFixed(2)}% loaded: ${ formatBytes(loaded)} of ${formatBytes(total)}`;
      console.log(`Upload: ${percent.toFixed(2)}% loaded: ${ formatBytes(loaded)} of ${formatBytes(total)}`);
    }
  }

  function submitMediaForm() {
    return new Promise((resolve, reject) => {
      const formData = new FormData(mediaForm);
      const xhr = new XMLHttpRequest();
      xhr.open("POST", mediaForm.action);

      // 📊 THIS is what you need
      xhr.upload.onprogress = (event) => {
        if (event.lengthComputable) {
          const percent = (event.loaded / event.total) * 100;
          uploadProgress(percent, event.loaded, event.total);
        }
      };

      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          uploadProgress(100, event.loaded, event.total);
          resolve(xhr.response);
        } else {
          reject("Upload failed 💥");
        }
      };

      xhr.onerror = () => reject("Network error");

      xhr.send(formData);
    });
  }

  //When the media is uploaded, update the label to show the file size and name
  fileInput.addEventListener("change", () => {
    console.log(fileInput.files);
    if (fileInput.files.length === 0) {
      updateMediaLabel(null, null);
      return;
    }
    const fileName = fileInput.files[0].name;
    const fileSize = fileInput.files[0].size;
    updateMediaLabel(fileName, fileSize);
  });

  function formatBytes(bytes, decimals = 2) {
    if (bytes === 0) return "0 bytes";
    if (!bytes || bytes < 0) return "0 bytes";

    const k = 1024;
    const sizes = ["bytes", "KB", "MB", "GB", "TB", "PB"];

    const i = Math.floor(Math.log(bytes) / Math.log(k));

    const value = bytes / Math.pow(k, i);

    return `${parseFloat(value.toFixed(decimals))} ${sizes[i]}`;
  }

  function updateMediaLabel(fileName, fileSize) {
    if (fileName && fileSize) {
      mediaDropzone.style.backgroundColor = "#eeeeee30";
      mediaLabel.innerText = (`${fileName}`);
      mediaHint.innerText = (`File Size: ${formatBytes(fileSize)}`);
    } else {
      mediaDropzone.style.backgroundColor = "inherit";
      mediaLabel.innerText = ("No Media Selected");
      mediaHint.innerText = (`Upload your content video and images`);
    }
  }

  if (fileMetadata) {
    console.log(fileMetadata);
    updateMediaLabel(fileMetadata.originalName, fileMetadata.fileSize);
  }


  const scheduledForInput = document.querySelector("#scheduledFor");
  const scheduleTimeZoneLabel = document.querySelector("#scheduledForLabel");
  const publishOption = document.querySelector("#publishOption");

  function updatePublishOption() {
    saveContentBtn.innerText = "Save";
    if (publishOption.value === "scheduled") {
      if (isNewPage) saveContentBtn.innerText = "Schedule";
      scheduledForInput.disabled = false;
      scheduleTimeZoneLabel.classList.remove("disabled");
    } else {
      if (publishOption.value === "draft") {
        if (isNewPage) saveContentBtn.innerText = "Save as draft";
      } else {
        if (isNewPage) saveContentBtn.innerText = "Publish";
      }
      scheduledForInput.disabled = true;
      scheduleTimeZoneLabel.classList.add("disabled");
    }
  }

  updatePublishOption();

  publishOption.addEventListener("change", (event) => {
    updatePublishOption();
  });
</script>

<%- include("../partials/dashboard-shell-end") %>