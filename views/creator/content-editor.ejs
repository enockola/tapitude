<%- include("../partials/dashboard-shell-start", { title }) %>
<script>
  console.log("contentPage:", <%- JSON.stringify(contentPage) %>);
</script>

<section class="content-header">
  <div>
    <p class="eyebrow">Content</p>
    <h1><%= contentPage ? "Edit Post" : "New Post" %></h1>
    <p>Create a simple public page for consumers to view from an NFC chip.</p>
  </div>

  <% if (publicUrl) { %>
    <a class="button button--secondary" href="<%= publicUrl %>" target="_blank">Preview Public Page</a>
  <% } %>
</section>

<section class="editor-layout">
  <article class="card">
    <% if (error) { %>
      <p class="form-error"><%= error %></p>
    <% } %>

    <form
      action="<%= contentPage ? `/content-pages/${contentPage._id}?_method=PATCH` : '/content-pages' %>"
      method="POST"
      class="form-stack"
    >


      <div class="media-upload">
        <label class="media-dropzone" for="mediaUpload">
          <span class="media-dropzone__icon">▧</span>

          <strong>Your Media</strong>
          <small>Upload your content video and images</small>

          <span class="button button--secondary button--small">
            Browse Files
          </span>

          <input
            id="mediaUpload"
            type="file"
            name="media"
            accept="image/*,video/*"
          >
        </label>

        <% if (contentPage?.mediaUrl) { %>
          <div class="current-media">
            <p class="eyebrow">Current Media</p>

            <% if (contentPage.mediaType?.startsWith("image")) { %>
              <img src="<%= contentPage.mediaUrl %>" alt="Uploaded media preview">
            <% } else if (contentPage.mediaType?.startsWith("video")) { %>
              <video controls src="<%= contentPage.mediaUrl %>"></video>
            <% } else { %>
              <a href="<%= contentPage.mediaUrl %>" target="_blank">View uploaded media</a>
            <% } %>
          </div>
        <% } %>
      </div>
        
      <label>
        Title
        <input
          type="text"
          name="title"
          placeholder="Add a catchy title..."
          value="<%= contentPage?.title || '' %>"
          required
        >
      </label>

      <label>
        Body
        <textarea name="body" rows="8" placeholder="Tell your story..."><%= contentPage?.body || '' %></textarea>
      </label>


      <label>
        Publish Option
        <select name="status" id="publishOption">
          <% const currentStatus = contentPage?.status || "published"; %>
          <option value="published" <%= currentStatus === "published" ? "selected" : "" %>>Publish now</option>
          <option value="scheduled" <%= currentStatus === "scheduled" ? "selected" : "" %>>Schedule for later</option>
        </select>
      </label>

      <label id="scheduledForLabel">
        Schedule Time
        <input
          type="datetime-local"
          name="scheduledFor"
          value="<%= contentPage?.scheduledFor ? new Date(contentPage.scheduledFor).toISOString().slice(0,16) : new Date().toISOString().slice(0,16) %>"
          >
      </label>

      <div class="form-actions">
        <button class="button" type="submit"><%= contentPage ? "Update Page" : "Publish" %></button>

        <% if (contentPage) { %>
          <button
            class="button button--danger"
            type="submit"
            form="delete-content-form"
          >
            Delete
          </button>
        <% } %>
      </div>
    </form>

    <% if (contentPage) { %>
      <form
        id="delete-content-form"
        action="/content-pages/<%= contentPage._id %>?_method=DELETE"
        method="POST"
      ></form>
    <% } %>
  </article>

  <aside class="card preview-card">
    <p class="eyebrow">Public Preview</p>
    <h2><%= contentPage?.title || "Your title will appear here" %></h2>
    <p><%= contentPage?.body || "Your content preview will appear here." %></p>

    <% if (contentPage?.externalLink) { %>
      <a class="button button--full" href="<%= contentPage.externalLink %>" target="_blank">
        <%= contentPage.buttonText || "Open Link" %>
      </a>
    <% } %>
  </aside>
</section>

<script>
  const scheduledForLabel  = document.querySelector("#scheduledForLabel");
  const publishOption = document.querySelector("#publishOption");
  
    function updatePublishOption(){
      if (publishOption.value === "scheduled") {
          scheduledForLabel.style.display = "block";
          } else {
          scheduledForLabel.style.display = "none";
          }
    }

    updatePublishOption();

  publishOption.addEventListener("change", (event) => {
     updatePublishOption();
    });
</script>

<%- include("../partials/dashboard-shell-end") %>
