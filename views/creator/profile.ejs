<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Settings</p>
    <h1>Creator Profile</h1>
    <p>Edit your creator profile and customize your brand.</p>
  </div>
</section>

<section class="card">

  <h2> Creator Profile Information</h2>
  <label>Content Hub Link: </label>
  <a href="/content-hub/<%= profile.creatorSlug %>" target="_blank" rel="noopener noreferrer">/content-hub/<%= profile.creatorSlug %></a>
  <br>

  <h2>Edit Profile</h2>
  <form class="form-stack" method="post" action="/creator/profile/update" enctype="multipart/form-data">

    <label>Display Name:
      <input type="text" name="displayName" value="<%= profile?.displayName || currentUser.name %>" />
    </label>

    <label>Brand Name:
      <input type="text" name="brandName" value="<%= profile?.brandName || "Not set yet" %>" />
    </label>

    <label>Logo</label>
    <p>For best results, it is recommended to upload a logo as a .png in just black or white.</p>
    <%- include("./partial_file_upload", {
          title: "Upload Logo",
          description: "Upload your brand logo",
          maxSizeBytes: 10,
          accept: "image/*"
        }) %>

    <% if (profileImageMetadata) { %>
    <script>
      const name = "<%=profileImageMetadata.originalName%>";
      const size = <%=profileImageMetadata.fileSize%>;
      updateMediaLabel(name, size);
    </script>
    <% } %>
    <div>
      <label>Brand Color:</label>
      <p>Choose a brand color to use for your brand, For best results, it is recommended to use a color from <a href="https://coolors.co/" target="_blank">coolors.co</a></p>
      <input type="color" name="brandColor" value="<%= profile?.brandColor || "#000" %>" />
    </div>


    <label>Bio:
      <textarea name="bio"><%= profile?.bio || "Not set yet" %></textarea>
    </label>

    <div class="form-actions">
      <button class="button" type="submit" id="uploadAttatchmentBtn"> <i class="ph ph-pencil"></i> Update</button>
    </div>

  </form>

</section>

<%- include("../partials/dashboard-shell-end") %>