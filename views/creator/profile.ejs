<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Settings</p>
    <h1>Creator Profile</h1>
    <p>Edit your creator profile and customize your brand.</p>
  </div>
</section>


<%- include("../partials/status-toast") %>

<section class="card main-card">

  <h2> Creator Profile Information</h2>
  <label>Content Hub Link: </label>
  <a href="/content-hub/<%= profile.creatorSlug %>" target="_blank" rel="noopener noreferrer">/content-hub/<%= profile.creatorSlug %></a>
  <br>

  <h2>Edit Profile</h2>
  <form class="form-stack" method="post" action="/creator/profile/update" enctype="multipart/form-data" id="profileForm">
    <label>Display Name:

    </label>
    <input type="text" name="displayName" value="<%= profile?.displayName || currentUser.name %>" />

    <label>Brand Name:

    </label>
    <p>Leave this blank if your logo already has your brand name printed on it</p>
    <input type="text" name="brandName" value="<%= profile?.brandName %>" />

    <label>Logo</label>
    <p>For best results, it is recommended to upload a logo as a .png in just black or white.</p>
    <%- include("./partial_file_upload", {
          title: "Upload Logo",
          description: "Upload your brand logo",
          maxSizeBytes: 1024 * 1024 * 2,
          accept: "image/*"
        }) %>

    <% if (profileImageMetadata) { %>
    <script>
      const name = "<%=profileImageMetadata.originalName%>";
      const size = <%=profileImageMetadata.fileSize%>;
      const fileKey = "<%=profileImageMetadata.fileKey%>";
      const mimeType = "<%=profileImageMetadata.contentType%>";
      updateMediaLabel(name, size, mimeType, fileKey);
    </script>
    <% } %>
    <div>
      <label>Theme Color:</label>
    </div>
    <p>Choose a brand color to use for your brand, For best results, it is recommended to use a color from <a href="https://coolors.co/" target="_blank">coolors.co</a></p>
    <input type="color" name="brandColor" value="<%= profile?.brandColor || "#000" %>" />


    <!--TODO: There isnt anywhere to display this on the content hub-->
    <div style="display: none;">
      <label>Bio:</label>
      <textarea name="bio"><%= profile?.bio ? profile.bio : "" %></textarea>
    </div>



    <div class="form-actions">
      <button class="button" type="button" id="updateProfile">
        <i class="ph ph-pencil"></i> Update
      </button>
    </div>
  </form>


</section>

<br>

<section class="card main-card">
  <h2>Account / Password Settings</h2>
  <p>You can change your password here.</p>
  <form action="/auth/change-password-creator/<%= currentUser._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <input type="hidden" name="redirectTo" value="<%= currentPath %>">

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" name="email" value="<%= currentUser.email %>" readonly disabled required>
    </div>

    <div class="form-group">
      <label for="email">New Password</label>
      <%- include("../partials/password-input", { name: "password1" }) %>
    </div>

    <div class="form-group">
      <label for="email">Confirm Password</label>
      <%- include("../partials/password-input", { name: "password2" }) %>
    </div>

    <button class="button" type="submit" class="button-primary">Update Password</button>
  </form>
</section>


<script>
  const form = document.getElementById("profileForm");
  const updateProfile = document.getElementById("updateProfile");
  const csrfToken = '<%= _csrf %>';

  updateProfile.addEventListener("click", () => {
    const formData = new FormData(form);
    const xhr = new XMLHttpRequest();
    xhr.open("POST", form.action);
    xhr.setRequestHeader("x-csrf-token", csrfToken);

    xhr.onload = () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        console.log("Success");
        window.location.reload();
      } else {
        console.error(xhr.status, xhr.responseText);
      }
    };
    xhr.send(formData);
  });
</script>

<%- include("../partials/dashboard-shell-end") %>