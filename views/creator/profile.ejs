<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Settings</p>
    <h1>Creator Profile</h1>
    <p>This page is a placeholder for creator profile settings.</p>
  </div>
</section>

<section class="card">
  <form class="form-stack" method="post" action="/creator/profile/update">

    <label>Display Name:
      <input type="text" name="displayName" value="<%= profile?.displayName || currentUser.name %>" />
    </label>

    <label>Brand Name:
      <input type="text" name="brandName" value="<%= profile?.brandName || "Not set yet" %>" />
    </label>

    <label>Logo</label>
    <label class="media-dropzone" for="mediaUploadInput" id="mediaUploadDropzone">

      <span class="media-dropzone__icon">
        <i class="ph ph-file-image"></i>
      </span>
      <strong id="mediaUploadLabel">Logo</strong>
      <small id="mediaUploadHint">Upload a logo for your brand</small>

      <span class="button button--secondary button--small">
        Browse Files
      </span>

      <input id="mediaUploadInput" type="file" name="logo" accept="image/*">
      <!-- We need to determine if the user wants to clear the logo or if they just arent uploading a new one -->
      <input type="hidden" name="clearLogo" value="false">
    </label>

    <div>
      <label>Brand Color:</label>
      <input type="color" name="brandColor" value="<%= profile?.brandColor || "#000" %>" />
    </div>


    <label>Bio:
      <textarea name="bio"><%= profile?.bio || "Not set yet" %></textarea>
    </label>

    <div class="form-actions">
      <button class="button" type="submit" id="uploadAttatchmentBtn"> <i class="ph ph-pencil"></i> Update</button>
    </div>

  </form>

</section>

<%- include("../partials/dashboard-shell-end") %>