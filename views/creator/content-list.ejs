<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Creator</p>
    <h1>My Content</h1>
    <p>Manage public content pages.</p>
  </div>
  <%- include("./partial-create-button") %>
</section>

<section class="cards-info">
<p><%= contentPageLimit?.currentCount ? `You have ${contentPageLimit.currentCount} / ${contentPageLimit.max} posts.` : "You have no active posts." %></p>

<% if (contentPageLimit?.atLimit) { %>
<section class="form-warning">
  <strong><i class="ph ph-exclamation"></i> Post limit reached.</strong>
  You have <%= contentPageLimit.currentCount %> active posts. Creating another post will permanently delete your
  <%= contentPageLimit.postsToDeleteOnCreate === 1 ? "oldest post and its media" : `${contentPageLimit.postsToDeleteOnCreate} oldest posts and their media` %>.
</section>
<% } %>
</section>

<section class="card">
  <% if (contentPages.length === 0) { %>
  <p><i class="ph ph-pen"></i> No content pages yet. Create one to get started!</p>
  <% } else { %>
  <div class="table-list">
    <% contentPages.forEach((page) => {     
        let updatedAt = "";
        function makePageDescription(page) {
          let pageTitle = ""; 
          if (page.body) {
            pageTitle =
              "\""+(page.body.length > 50
                ? page.body.slice(0, 50) + "..."
                : page.body)+"\"";
          } 
          if(page.fileKey) {
            pageTitle += " (1 attachment)";
          }
          return pageTitle;
        }
        let pageTitle = makePageDescription(page);
        %>
    <article class="table-row mini-list__item">
      <div class="content-summary">
        <label>Updated: <%= page.updatedAt ? formatEtDateTime(page.updatedAt) : "No date" %></label>


        <span><%= pageTitle %></span>

        <% if(page.publishDate < new Date()) { %>
        <label class="badge badge--success">Published: <%= page.publishDate ? formatEtDateTime(page.publishDate) : "No date" %></label>
        <% } else {  %>
        <label class="badge badge--warn">Scheduled: <%= page.publishDate ? formatEtDateTime(page.publishDate) : "No date" %></label>
        <% } %>

      </div>

      <div class="row-actions">
        <a class="button button--small button--secondary" href="/creator/pages/<%= page._id %>/editor">
          <i class="ph-fill ph-pencil-simple-line" style="margin-right: 5px;"></i> <span>Edit</span>
        </a>
      </div>
    </article>
    <% }) %>
  </div>
  <% } %>
</section>

<%- include("../partials/dashboard-shell-end") %>