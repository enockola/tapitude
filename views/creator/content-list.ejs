<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Creator</p>
    <h1>My Content</h1>
    <p>Manage public content pages.</p>
  </div>
  <%- include("./create-button") %>
</section>

<section class="card">
  <% if (contentPages.length === 0) { %>
  <p>No content pages yet.</p>
  <% } else { %>
  <div class="table-list">
    <% contentPages.forEach((page) => { 
        const pageTitle = "Page "+page._id; 
        %>
    <article class="table-row">
      <div class="content-summary">
        <strong><%= pageTitle %></strong>

        <!-- Page status  -->

        <small class="badge">
          <% if (page.status === "published") { %>Published: <%= page.publishedAt ? formatEtDateTime(page.publishedAt) : "No date" %>
          <% } else if (page.status === "scheduled") { %>Scheduled: <%= page.scheduledFor ? formatEtDateTime(page.scheduledFor) : "No date" %>
          <% } else { %>Draft
          <% } %>
        </small>
      </div>

      <div class="row-actions">
        <a class="button button--small button--secondary" href="/creator/pages/<%= page._id %>/editor">
          Edit
        </a>
      </div>
    </article>
    <% }) %>
  </div>
  <% } %>
</section>

<%- include("../partials/dashboard-shell-end") %>