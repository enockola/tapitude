<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Creator</p>
    <h1>My Content</h1>
    <p>Manage public content pages.</p>
  </div>
  <%- include("./create-button") %>
</section>

<section class="card">
  <% if (contentPages.length === 0) { %>
    <p>No content pages yet.</p>
  <% } else { %>
    <div class="table-list">
      <% contentPages.forEach((page) => { %>
        <article class="table-row">
          <div class="content-summary">
            <strong><%= page.title %></strong>

            <% if (page.status === "published") { %>
              <a class="public-link" href="/p/<%= page.slug %>" target="_blank">
                /p/<%= page.slug %>
              </a>

              <small class="badge">
                Published:
                <%= page.publishedAt ? new Date(page.publishedAt).toLocaleDateString() : "No date" %>
              </small>
            <% } else if (page.status === "scheduled") { %>
              <span>/p/<%= page.slug %></span>

              <small class="badge">
                Scheduled:
                <%= page.scheduledFor ? new Date(page.scheduledFor).toLocaleDateString() : "No date" %>
              </small>
            <% } else { %>
              <span>/p/<%= page.slug %></span>
              <small class="badge">Draft</small>
            <% } %>
          </div>

          <div class="row-actions">
            <a class="button button--small button--secondary" href="/content-pages/<%= page._id %>/edit">
              Edit
            </a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("../partials/dashboard-shell-end") %>
