<%- include("./shell-start", { "title": "Tapitude Content Hub" }) %>



<div class="feed" id="feed">
  <% for (contentPage in contentPages) { %>
  <div class="post">
    <div class="post-text"><%= contentPage.body %></div>
    <img src="https://images.landscapingnetwork.com/pictures/images/331x255Exact/walkway-and-path_4/front-flagstone-walkway-entrance-walls-belknap-landscape-co-inc_10019.jpg" />
    <div class="reactions" onclick="showReactions(1)">
      👍 12 ❤️ 5 😂 3 · View reactions
    </div>
    <div class="actions">
      <button onclick="react('like')">👍 Like</button>
      <button onclick="react('comment')">💬 Comment</button>
      <button onclick="react('share')">↗ Share</button>
    </div>
  </div>
  <% } %>
</div>

<div id="loadMore"><i class="ph ph-circle-notch ph-spin" style="padding-bottom: 1.5px;"></i> Loading...</div>


<%- include("./shell-end") %>