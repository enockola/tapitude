<header class="topbar creator-topbar">
  <div class="left-group" style="display: flex; gap: 10px;">
    <% if(creatorProfile.profileImageKey ) { %>
      <img class="brand-logo" src="/storage/<%= creatorProfile.profileImageKey %>" alt="Creator Avatar" />
    <% } else { %>
      <a class="brand" href="/content-hub/<%= creatorProfile.creatorSlug %>"><%= creatorProfile.brandName %></a>
    <% } %>
    
  </div>
<!-- <span class="eyebrow"> <%= creatorProfile.displayName %>'s Content Hub</span> -->
