<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ? `${title} | Tapitude` : "Tapitude" %></title>
  <link rel="stylesheet" href="/css/content-hub.css" />
  <style>
    :root {
      --brand-color-primary: <%=creatorProfile.brandColor %>;
    }
  </style>
  <!-- https://github.com/phosphor-icons/homepage#phosphor-icons -->
  <!-- Select icons in https://phosphoricons.com/ -->
  <!-- <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/bold/style.css"
    /> -->
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css" />

  <script src="/js/socket.io/socket.io.min.js"></script>
  <script>
    const currentPath = "<%= currentPath %>";
    const creatorSlug = "<%= creatorProfile.creatorSlug %>";
    const creatorId = "<%= creatorProfile.userId %>";
    const creatorName = "<%= creatorProfile.displayName %>";
    const brandColor = "<%= creatorProfile.brandColor %>";
    window.isProduction = <%= isProduction %>;
    if(!window.isProduction) {
      console.log("== In development mode ==");
      console.log("Current path = ", currentPath);
      console.log("Current path = ", currentPath);
      console.log("Creator slug = ", creatorSlug);
      console.log("Creator user id = ", creatorId);
      console.log("Creator name = ", creatorName);
      console.log("Brand color = ", brandColor);
    }
    document.title = creatorName.trim()+"'s Content Hub" + " | Tapitude";
  </script>
</head>

<body></body>

</html>


<header class="topbar">
  <div>
    <% if(creatorProfile.profileImageKey ) { %>
    <!-- <a  href="/content-hub/<%= creatorProfile.creatorSlug %>"> -->
    <img class="brand-logo" src="/storage/<%= creatorProfile.profileImageKey %>" alt="Creator Avatar" />
    <!-- </a> -->
    <% } if(creatorProfile.brandName) { %>
    <a class="creatorBrand" href="/content-hub/<%= creatorProfile.creatorSlug %>"><%= creatorProfile.brandName %></a>
    <% } %>
  </div>
</header>