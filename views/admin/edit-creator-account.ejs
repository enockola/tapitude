<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>Edit Creator</h1>
    <p>Manage creator account of <%= creator.name %>.</p>
  </div>
</section>


<%- include("../partials/status-toast") %>
<br>
<section class="card main-card">

  <h2>Creator Profile Information</h2>
  <div>
    <label for="name">Content Hub Link</label>
    <a href="/content-hub/<%= creatorProfile.creatorSlug %>">/content-hub/<%= creatorProfile.creatorSlug %></a>
    <br /><br />
    <label for="name">Brand Name</label>
    <span><%= creatorProfile.brandName %></span>
  </div>

  <!-- <div class="divider"></div> -->

  <h2>Account Settings</h2>
  <form action="/admin/edit-creator-account/<%= creator._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <div class="form-group">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" value="<%= creator.name %>" required>
    </div>

    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" name="email" value="<%= creator.email %>" required>
    </div>

    <div class="form-group">
      <label for="status">Account Status</label>
      <select id="status" name="status">
        <option value="active" <%= creator.status === "active" ? "selected" : "" %>>Active</option>
        <option value="disabled" <%= creator.status === "disabled" ? "selected" : "" %>>Disabled</option>
      </select>
    </div>
    <button class="button" type="submit" class="button-primary">Save Changes</button>
  </form>
</section>

<br>

<section class="card main-card">
  <h2>Change Creator Password</h2>
  <form action="/auth/change-password-creator/<%= creator._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <input type="hidden" name="redirectTo" value="<%= currentPath %>">

    <div class="form-group">
      <label for="email">New Password</label>
      <%- include("../partials/password-input", { name: "password1" }) %>
    </div>

    <div class="form-group">
      <label for="email">Confirm Password</label>
      <%- include("../partials/password-input", { name: "password2" }) %>
    </div>

    <button class="button" type="submit" class="button-primary">Update Password</button>
  </form>
</section>

<br><br>
<div class="divider main-card"></div>
<br><br>

<section class="card main-card">
  <h2>Danger Zone</h2>
  <p>Permanently delete this creator account and all associated data. This action cannot be undone!
  </p>

  <form id="delete-creator-form" action="/admin/delete-creator-account/<%= creator._id %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">
    <!-- <input type="hidden" name="redirectTo" value="<%= currentPath %>"> -->

    <div id="confirm-delete-input" style="display: none;">
      <div class="form-group">
        <label for="email">Type the creator's email address to confirm</label>
        <input type="email" name="email" value="" id="creator-delete-email" required>
      </div>
      <div class="form-group">
        <label for="password">Type the creator's password to confirm</label>
        <%- include("../partials/password-input", { name: "password" }) %>
      </div>
    </div>

    <div class="form-actions">
      <button type="button" class="button danger" id="delete-creator-button">
        Delete Account
      </button>
    </div>

  </form>
</section>
<script>
  //TODO: We can send requests by putting the CSRF token in the header instead of the body
  // async function deleteAccount() {
  //   const response = await fetch('/admin/delete-creator-account/<%= creator._id %>', {
  //     method: 'POST',
  //     headers: {
  //       'Content-Type': 'application/json',
  //       'X-CSRF-Token': '<%= _csrf %>'
  //     },
  //     body: JSON.stringify({
  //       /* your data */ })
  //   });

  //   if (response.ok) {
  //     window.location.reload();
  //   }
  // }

  const deleteCreatorButton = document.getElementById("delete-creator-button");
  const confirmBoxes = document.getElementById("confirm-delete-input");
  deleteCreatorButton.addEventListener("click", confirmDelete);
  const deleteConfirmEmail = document.getElementById("creator-delete-email");

  deleteConfirmEmail.addEventListener("input", () => {
    if (deleteConfirmEmail.value === "<%= creator.email %>") {
      deleteCreatorButton.disabled = false;
    } else {
      deleteCreatorButton.disabled = true;
    }
  });

  function confirmDelete() {
    if (confirmBoxes.style.display === "none") {
      confirmBoxes.style.display = "block";
      deleteCreatorButton.disabled = true;
    } else {
      showDialog({
        description: "Are you sure you want to delete this creator account? This action cannot be undone!",
        confirmText: "Delete",
        danger: true,
        onConfirm: async () => {
          document.getElementById("delete-creator-form").submit();
        }
      });
    }
  }
</script>
<%- include("../partials/dashboard-shell-end") %>