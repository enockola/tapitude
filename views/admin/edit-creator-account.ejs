  //   });

  //   if (response.ok) {
  //     window.location.reload();
  //   }
  // }

  function confirmDelete() {
    showDialog({
      description: "Are you sure you want to delete this creator account? This action cannot be undone!",
      confirmText: "Delete",
      danger: true,
      onConfirm: async () => {
        document.getElementById("delete-creator-form").submit();
      }
    });
  }
</script>
<%- include("../partials/dashboard-shell-end") %>