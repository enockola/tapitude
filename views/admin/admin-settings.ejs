<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>Admin Settings</h1>
    <p>Manage creator account of this admin.</p>
  </div>
</section>
<section class="card main-card">
<%- include("../partials/status-toast") %>
  <h2>Change Admin Password</h2>
  <form action="/auth/change-password-admin" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" name="email" value="<%= currentUser.email %>" readonly required disabled>
    </div>

    <!-- <div class="form-group">
      <label for="email">Current Password</label>
      <input type="password" name="currentPassword" value="" required>
    </div> -->

    <div class="form-group">
      <label for="email">New Password</label>
      <input type="password" name="password1" value="" required>
    </div>

    <div class="form-group">
      <label for="email">Confirm Password</label>
      <input type="password" name="password2" value="" required>
    </div>

    <button class="button" type="submit" class="button-primary">Update Password</button>
  </form>
</section>

