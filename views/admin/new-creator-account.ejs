<%- include("../partials/dashboard-shell-start", { title }) %>

<section class="content-header">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>New Creator Account</h1>
    <p>Create a login account for a new content creator.</p>
  </div>
</section>

<section class="card main-card">
  <% if (error) { %>
  <p class="form-error"><%= error %></p>
  <% } %>

  <form action="/admin/creators/new" method="POST">
    <input type="hidden" name="_csrf" value="<%= _csrf %>">

    <h2>Information</h2>

    <div class="form-group">
      Creator's Full Name
      <input type="text" name="name" required>
    </div>

    <div class="form-group">
      Creator Brand Name (Optional)
      <input type="text" name="brandName">
    </div>

    <h2>Credentials</h2>

    <div class="form-group">
      Creator Email
      <input type="email" name="email" required>
    </div>

    <div class="form-group">
      <label for="email">New Password</label>
      <%- include("../partials/password-input", { name: "password1" }) %>
    </div>

    <div class="form-group">
      <label for="email">Confirm Password</label>
      <%- include("../partials/password-input", { name: "password2" }) %>
    </div>

    <div class="form-actions">
      <button class="button" type="submit">Create Account</button>
    </div>
  </form>
</section>

<%- include("../partials/dashboard-shell-end") %>